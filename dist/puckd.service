[Unit]
Description=puckd - Steam Controller (2026) / Puck userspace driver
Documentation=file://%h/.config/puckd.toml

[Service]
Type=simple
# systemd looks for a bare name in /usr/local/bin, /usr/bin, ...; otherwise use the full path.
ExecStart=puckd
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
